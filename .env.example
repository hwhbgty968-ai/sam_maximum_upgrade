# Copy this file to .env and fill in what you use. Never commit .env to GitHub.
# You need AT LEAST ONE AI key. Add more and Sam can fall back between them and use Sam Council.

# ---- AI providers ----
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=         # https://console.anthropic.com (Claude)
OPENAI_API_KEY=            # https://platform.openai.com/api-keys
DEEPSEEK_API_KEY=          # https://platform.deepseek.com

# Which provider Sam tries first (others are fallbacks)
PROVIDER_ORDER=gemini,anthropic,openai,deepseek

# Optional model overrides per provider and tier (fast / balanced / deep).
# Sam checks these against each provider's real model list at startup and swaps in the
# closest available model if one doesn't exist (watch the server log for warnings).
# GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# GEMINI_MODEL_BALANCED=gemini-3.5-flash
# GEMINI_MODEL_DEEP=gemini-3.1-pro-preview
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_BALANCED=claude-sonnet-5-5
# ANTHROPIC_MODEL_DEEP=claude-opus-5-5
# OPENAI_MODEL_BALANCED=gpt-6.1-terra
# DEEPSEEK_MODEL_DEEP=deepseek-v4-pro

# Reply length budget (tokens) for "balanced"; fast uses half, deep uses double
MAX_TOKENS=4000
# Model tier the Sam Council chair uses to combine answers
COUNCIL_CHAIR_SPEED=balanced
# At startup Sam sends a tiny test message to each model (at most once every 6 hours,
# a few tokens each) so it knows which ones really answer. Set to 0 to turn this off.
# PROVIDER_STARTUP_TEST=1

# ---- Database ----
# Postgres connection string (e.g. Neon). When set, everything is stored there permanently.
# Leave empty to use a local SQLite file (sam.sqlite in DATA_DIR) — fine on your own computer.
DATABASE_URL=
# PG_POOL_MAX=5

# ---- Guest mode ("Try Sam without an account") ----
# GUEST_MODE=0               # turn guest mode off
# GUEST_DAILY_MESSAGES=10    # free messages per guest per day (Fast models only)
# GUEST_NETWORK_DAILY=30     # per network per day, so clearing cookies doesn't reset the allowance
# GUEST_DAILY_TOTAL=300      # all guests together per day: a cost safety net
# GUEST_IDLE_MIN=120         # guest chats are deleted after this long without a message

# ---- Admin ----
# The first admin is set with a one-time setup code printed in the server log
# ("Admin setup code: …"): log in, open Settings → Become admin, enter it.
# Optional: choose your own code instead of a generated one.
# ADMIN_SETUP_CODE=
# Optional: prices in USD per 1M input/output tokens, so the admin dashboard can show costs.
# MODEL_PRICES={"gemini-3.7-flash":[0.30,2.50],"claude-sonnet-5-5":[3,15]}
# Daily automatic SQLite backup (set to 0 to turn off) and how many backup files to keep
AUTO_BACKUP=1
BACKUP_KEEP=14

# ---- Server ----
PORT=3000
# Long random string. If left empty, Sam generates one and stores it in the database.
SESSION_SECRET=
# Where sam.sqlite and local backups live (SQLite only).
# DATA_DIR=./data
# Messages per user per minute
CHAT_RATE_PER_MIN=20
# Extra sites allowed to make requests (rarely needed), comma-separated full origins
# ALLOWED_ORIGINS=https://sam.example.com
# Set to 1 if you run behind a proxy that isn't detected automatically
# TRUST_PROXY=1
