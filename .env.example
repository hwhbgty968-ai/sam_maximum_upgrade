# Copy this file to .env and fill in what you use. Never commit .env to GitHub.
# You need AT LEAST ONE AI key. Add more and Sam can fall back between them and use Sam Council.

# ---- AI providers ----
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=         # https://console.anthropic.com (Claude)
OPENAI_API_KEY=            # https://platform.openai.com/api-keys
DEEPSEEK_API_KEY=          # https://platform.deepseek.com

# Which provider Sam tries first (others are fallbacks)
PROVIDER_ORDER=gemini,anthropic,openai,deepseek

# Optional model overrides per provider and tier (fast / balanced / deep).
# Sam checks these against each provider's real model list at startup and swaps in the
# closest available model if one doesn't exist (watch the server log for warnings).
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_BALANCED=gemini-3.7-flash
# GEMINI_MODEL_DEEP=gemini-3.8-flash
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_BALANCED=claude-sonnet-5-5
# ANTHROPIC_MODEL_DEEP=claude-opus-5-5
# OPENAI_MODEL_BALANCED=gpt-6.1-terra
# DEEPSEEK_MODEL_DEEP=deepseek-v4-pro

# Reply length budget (tokens) for "balanced"; fast uses half, deep uses double
MAX_TOKENS=4000
# Model tier the Sam Council chair uses to combine answers
COUNCIL_CHAIR_SPEED=balanced

# ---- Server ----
PORT=3000
# Long random string. If left empty, Sam generates one and stores it in the database.
SESSION_SECRET=
# Where sam.sqlite lives. On Render, point this at your persistent disk (e.g. /var/data).
# DATA_DIR=/var/data
# Messages per user per minute
CHAT_RATE_PER_MIN=20
# Set to 1 if you run behind a proxy that isn't detected automatically
# TRUST_PROXY=1
